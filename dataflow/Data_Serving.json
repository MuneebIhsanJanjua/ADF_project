{
	"name": "Data_Serving",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "Is_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirline"
				},
				{
					"linkedService": {
						"referenceName": "Is_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "DimFlight"
				},
				{
					"linkedService": {
						"referenceName": "Is_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "FactBooking"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Is_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "SinkDimgFlightGold"
				},
				{
					"linkedService": {
						"referenceName": "Is_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "sinkDimAirlineGold"
				}
			],
			"transformations": [
				{
					"name": "JoinDimAline"
				},
				{
					"name": "selectColumns"
				},
				{
					"name": "AggregateAirline"
				},
				{
					"name": "window1"
				},
				{
					"name": "FilterTop5Sales"
				},
				{
					"name": "join1"
				},
				{
					"name": "selectColumn"
				},
				{
					"name": "AggregateFighNumber"
				},
				{
					"name": "windowTop"
				},
				{
					"name": "filterTop5"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'sliver',",
				"     folderPath: 'DimAirline') ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_timestamp as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'sliver',",
				"     folderPath: 'DimFlight') ~> DimFlight",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'sliver',",
				"     folderPath: 'Factbooking') ~> FactBooking",
				"FactBooking, DimAirline join(FactBooking@airline_id == DimAirline@airline_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinDimAline",
				"JoinDimAline select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id,",
				"          airline_id = FactBooking@airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airline_name,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumns",
				"selectColumns aggregate(groupBy(airline_name),",
				"     total_sales = sum(ticket_cost)) ~> AggregateAirline",
				"AggregateAirline window(desc(total_sales, true),",
				"     top = denseRank()) ~> window1",
				"window1 filter(top < 6) ~> FilterTop5Sales",
				"DimFlight, JoinDimAline join(DimFlight@flight_id == FactBooking@flight_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          flight_id = DimFlight@flight_id,",
				"          flight_number,",
				"          departure_timestamp,",
				"          arrival_time,",
				"          booking_id,",
				"          passenger_id,",
				"          airline_id = FactBooking@airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airline_id = DimAirline@airline_id,",
				"          airline_name,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumn",
				"selectColumn aggregate(groupBy(airline_name),",
				"     total_flight = count(flight_number)) ~> AggregateFighNumber",
				"AggregateFighNumber window(desc(total_flight, true),",
				"     top = denseRank()) ~> windowTop",
				"windowTop filter(top < 6) ~> filterTop5",
				"filterTop5 alterRow(upsertIf(1==1)) ~> alterRow1",
				"FilterTop5Sales alterRow(upsertIf(1==1)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'BusinessViewFlight',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: false,",
				"     keys:['airline_name'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkDimgFlightGold",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'BussinesViewAirline',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDimAirlineGold"
			]
		}
	}
}