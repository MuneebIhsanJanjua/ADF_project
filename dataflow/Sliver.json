{
	"name": "Sliver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "df_onprem_airline",
						"type": "DatasetReference"
					},
					"name": "OnpremDimAirline"
				},
				{
					"dataset": {
						"referenceName": "df_onprem_flight",
						"type": "DatasetReference"
					},
					"name": "OnpremDimFlight"
				},
				{
					"dataset": {
						"referenceName": "df_onprem_passenger",
						"type": "DatasetReference"
					},
					"name": "OnpremDimPassenger"
				},
				{
					"dataset": {
						"referenceName": "df_Giithub_DimAirport",
						"type": "DatasetReference"
					},
					"name": "GtithubDimAirpot"
				},
				{
					"dataset": {
						"referenceName": "df_Sql_Parquet",
						"type": "DatasetReference"
					},
					"name": "SqlPaquet"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumnCountry"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedGenderFlag"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OnpremDimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_time as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OnpremDimFlight",
				"source(output(",
				"          passenger_id as short,",
				"          full_name as string,",
				"          gender as string,",
				"          age as short,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> OnpremDimPassenger",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> GtithubDimAirpot",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SqlPaquet",
				"OnpremDimAirline derive(country = upper(country)) ~> derivedColumnCountry",
				"OnpremDimFlight select(mapColumn(",
				"          flight_id,",
				"          flight_number,",
				"          departure_timestamp = departure_time,",
				"          arrival_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"OnpremDimPassenger derive(GenderFlag = iif(gender == 'M', 'Male', iif(gender == 'F', 'Female', gender))) ~> derivedGenderFlag"
			]
		}
	}
}