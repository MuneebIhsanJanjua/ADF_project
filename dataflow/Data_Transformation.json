{
	"name": "Sliver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "df_onprem_airline",
						"type": "DatasetReference"
					},
					"name": "OnpremDimAirline"
				},
				{
					"dataset": {
						"referenceName": "df_onprem_flight",
